#!/usr/bin/env bash
# Play on the HearthDAoC server @SERVER@ (edition @EDITION@) through Proton.
# Add this file to Steam as a non-Steam game WITHOUT forcing a compatibility tool;
# any launch options must end with %command%.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CL="$HERE/client"
SERVER="${HEARTHDAOC_SERVER:-@SERVER@}"
CREDS="$HERE/account.txt"

# Errors go to the terminal, and to a dialog when started from Steam (no terminal to read them).
die() {
    echo "play.sh: $*" >&2
    if [[ ! -t 2 && -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        if command -v zenity >/dev/null; then zenity --error --title="HearthDAoC" --text="$*" 2>/dev/null || true
        elif command -v notify-send >/dev/null; then notify-send "HearthDAoC" "$*" || true; fi
    fi
    exit 1
}

if [[ ! -f "$CREDS" ]]; then
    if command -v zenity >/dev/null && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        form="$(zenity --forms --title="HearthDAoC login" \
            --text="Server: $SERVER\nUse a password you use nowhere else." \
            --add-entry="Account (letters and digits)" --add-password="Password" --separator=$'\n')" || die "Login cancelled."
        acct="$(sed -n 1p <<<"$form")"; pass="$(sed -n 2p <<<"$form")"
    elif [[ -t 0 ]]; then
        read -rp "Account (letters and digits): " acct
        read -rsp "Password (use one you use nowhere else): " pass; echo
    else
        die "No login saved yet. Run $HERE/play.sh once from a terminal (or install zenity) to enter your account."
    fi
    [[ "$acct" =~ ^[A-Za-z0-9]+$ ]] || die "Account names may only contain letters and digits."
    [[ -n "$pass" && ! "$pass" =~ [[:space:]] ]] || die "The password must be non-empty with no spaces."
    (umask 077 && printf 'Account: %s\nPassword: %s\n' "$acct" "$pass" > "$CREDS")
fi
ACCT="$(sed -n 's/^Account:[[:space:]]*//p' "$CREDS" | tr -d '\r')"
PASS="$(sed -n 's/^Password:[[:space:]]*//p' "$CREDS" | tr -d '\r')"

STEAM_ROOT="$(readlink -f "$HOME/.steam/steam")"
# Every Steam library (Steam > Settings > Storage), the main one first.
steam_libraries() {
    echo "$STEAM_ROOT"
    sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$STEAM_ROOT/steamapps/libraryfolders.vdf" 2>/dev/null || true
}
library_with() {  # library_with <path inside a library>: print the first library that has it
    local lib
    while read -r lib; do
        if [[ -e "$lib/$1" ]]; then echo "$lib"; return 0; fi
    done < <(steam_libraries)
    return 1
}
if [[ -n "${DAOC_PROTON:-}" ]]; then
    PROTON_DIR="$DAOC_PROTON"
elif lib="$(library_with "steamapps/common/Proton - Experimental/proton")"; then
    PROTON_DIR="$lib/steamapps/common/Proton - Experimental"
else
    die "Proton Experimental is not installed in any Steam library. Install it in Steam (Library > Tools), or set DAOC_PROTON."
fi
[[ -x "$PROTON_DIR/proton" ]] || die "No proton in $PROTON_DIR."
tool_appid="$(sed -n 's/.*"require_tool_appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$PROTON_DIR/toolmanifest.vdf" 2>/dev/null || true)"
[[ -n "$tool_appid" ]] || die "Cannot read $PROTON_DIR/toolmanifest.vdf."
lib="$(library_with "steamapps/appmanifest_$tool_appid.acf")" ||
    die "The Steam Linux Runtime (app $tool_appid) that $(basename "$PROTON_DIR") needs is not installed; install it from Steam."
runtime_dir="$(sed -n 's/.*"installdir"[[:space:]]*"\(.*\)".*/\1/p' "$lib/steamapps/appmanifest_$tool_appid.acf" || true)"
RUNTIME="$lib/steamapps/common/$runtime_dir"
[[ -n "$runtime_dir" && -x "$RUNTIME/_v2-entry-point" ]] ||
    die "The Steam Linux Runtime (app $tool_appid) is not fully installed in $lib; verify it in Steam."

unset WINEPREFIX WINEDLLOVERRIDES
export STEAM_COMPAT_DATA_PATH="$HERE/proton"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT"
export STEAM_COMPAT_TOOL_PATHS="$PROTON_DIR:$RUNTIME"
# Keep Steam's ids when launched from Steam; Proton's steam.exe needs SteamGameId set to keep
# waiting on the game after connect.exe exits.
export SteamAppId="${SteamAppId:-0}" SteamGameId="${SteamGameId:-0}"
export PROTON_USE_XALIA="${PROTON_USE_XALIA:-0}"
mkdir -p "$STEAM_COMPAT_DATA_PATH"

run_proton() { "$RUNTIME/_v2-entry-point" --verb=waitforexitandrun -- "$PROTON_DIR/proton" waitforexitandrun "$@"; }

PFX="$STEAM_COMPAT_DATA_PATH/pfx"
if [[ ! -f "$PFX/user.reg" ]]; then
    echo "Creating the Proton prefix (first run only)..."
    run_proton cmd.exe /c exit || true
fi
# The client drops the last character of paths.dat's final line (no trailing newline), so
# "settings=OfflineDAoC034" means the profile folder "OfflineDAoC03".
profile_name="$(sed -n 's/^settings=//p' "$CL/paths.dat" | tr -d '\r')"
profile_name="${profile_name%?}"
PROFILE="$PFX/drive_c/users/steamuser/AppData/Roaming/Electronic Arts/Dark Age of Camelot/$profile_name"
if [[ ! -f "$PROFILE/user.dat" ]]; then
    mkdir -p "$PROFILE"
    printf '[main]\r\nfullscreen_windowed=1\r\n' > "$PROFILE/user.dat"
fi

cd "$CL"
# Proton doesn't search the working directory for the exe: pass a Linux path for connect.exe and
# the game DLL as a Windows path (Z: is /).
exec "$RUNTIME/_v2-entry-point" --verb=waitforexitandrun -- "$PROTON_DIR/proton" waitforexitandrun \
    "$CL/connect.exe" "Z:${CL//\//\\}\\game.dll" "$SERVER" "$ACCT" "$PASS"
