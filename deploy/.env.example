# Copy to .env and adjust. ./hdc and docker compose read this file; put values with spaces in double quotes.
HEARTHDAOC_TAG=v0.34b-hearth.1
# classic = 0.34 (no custom class), b = 0.34b (Sluaghbinder). Fixed once the world exists.
HEARTHDAOC_EDITION=classic
# Ports must differ from OpenDAoC's 10300/10400 on the same machine.
HEARTHDAOC_PORT=10301
HEARTHDAOC_UDP_PORT=10401
# 0.0.0.0 = all interfaces (limit access with the host firewall; see HANDOFF.md).
HEARTHDAOC_LISTEN_IP=0.0.0.0
# First login creates the account. Turn off (./hdc auto-accounts off) before remote players join.
HEARTHDAOC_AUTO_ACCOUNTS=True
HEARTHDAOC_SERVER_NAME="HearthDAoC"
HEARTHDAOC_BACKUP_KEEP=7
HEARTHDAOC_MEM_LIMIT=10g
HEARTHDAOC_CPUS=4
HEARTHDAOC_UID=1000
HEARTHDAOC_GID=1000
TZ=America/Chicago
