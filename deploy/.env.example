# Copy to .env and adjust. ./hdc and docker compose read this file; put values with spaces in double quotes.
# The release; set in each release's deploy bundle, and ./hdc update keeps it current.
HEARTHDAOC_TAG=
# classic = 0.35 (no custom class), b = 0.35b (Sluaghbinder). Fixed once the world exists.
HEARTHDAOC_EDITION=classic
# Ports must differ from OpenDAoC's 10300/10400 on the same machine.
HEARTHDAOC_PORT=10301
HEARTHDAOC_UDP_PORT=10401
# 0.0.0.0 = all interfaces (limit access with the host firewall; see HANDOFF.md).
HEARTHDAOC_LISTEN_IP=0.0.0.0
# First login creates the account. Turn off (./hdc auto-accounts off) before remote players join.
HEARTHDAOC_AUTO_ACCOUNTS=True
HEARTHDAOC_SERVER_NAME="HearthDAoC"
# OfflineDAoC's single-player shortcuts that only GMs may use here ("none" = everyone may use them).
# /tele = teleport to a bot or monster camp, /tc = teleport to the Realm Exchange. Companion bots
# (/spawn, /grind, /raid) stay open to everyone.
HEARTHDAOC_GM_ONLY_COMMANDS="/tele;/tc"
# on = a new level-1 character of a classic race is asked once, a few seconds after it first enters the
# world, whether to begin in its realm's Shrouded Isles town (Caer Gothwaite, Aegirhamn or the Grove of
# Domnann) or stay in its home village. off = nobody is asked. Case is ignored.
HEARTHDAOC_SI_START_CHOICE=on
# on = a gamebot released after a death in RvR or a battleground waits at a safe spot (a bind of its realm, or
# its realm's arrival point in a battleground; a frontier warband at its border keep) and goes back so it arrives
# just as it is worth realm points again, 300 s after its last death. off = released gamebots go straight back,
# as before. Case is ignored.
HEARTHDAOC_BOT_RP_TIMER_WAIT=on
# on = the server measures the game loop's CPU per kind of bot and player and writes BOT_CPU lines to the server log
# every minute, and rows to /data/logs/bot-cpu.csv; it costs about 1-5% of one core while on. off = nothing is
# measured. A GM can also turn it on or off in game with /botcpu, until the next start. Case is ignored.
HEARTHDAOC_BOT_CPU=off
# Player bots (#137): real player characters the server plays itself, for TEST WORLDS ONLY. off = nothing at all. N or
# alb:N,mid:N,hib:N logs that many in (accounts hdbot-...) and puts the server in test-world mode for the run:
# Discord posts off, a status line every minute, a forced full memory collection at minute 51. See
# docs/fork/player-bots.md in the repository.
HEARTHDAOC_PLAYER_BOTS=off
# Read only when player bots are on. gamebot = they wake only the NPCs a GameBot would, plus their own target,
# attackers, pet, the NPCs they talk to and those their current quests name (the lever); player = like a player.
HEARTHDAOC_PLAYER_BOT_WAKE=gamebot
# Read only when player bots are on: a start spots file in the data volume (e.g. /data/player-bot-spots.txt), one bot a
# line, realm|region|x|y[|z[|level|class|race]]. Empty = each bot starts at its realm's start.
HEARTHDAOC_PLAYER_BOT_SPOTS=
# Minutes between automatic world saves (1-60). A crash or power cut loses at most this much;
# ./hdc stop always saves first.
HEARTHDAOC_AUTOSAVE_MINUTES=5
# Daily backups to keep in the volume (1-365).
HEARTHDAOC_BACKUP_KEEP=7
HEARTHDAOC_MEM_LIMIT=10g
HEARTHDAOC_CPUS=4
HEARTHDAOC_UID=1000
HEARTHDAOC_GID=1000
TZ=America/Chicago
