#!/usr/bin/env bash
# hdc: manage the HearthDAoC server deployment. Run it from the folder holding
# compose.yml and .env. See HANDOFF.md for setup.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[[ -f "$here/.env" ]] || { echo "Missing $here/.env (copy .env.example to .env and edit it)." >&2; exit 1; }
# Not exported: compose reads .env itself, and exported values would override edits hdc makes to .env.
source "$here/.env"

PROJECT="${HEARTHDAOC_PROJECT:-hearthdaoc}"
CONTAINER="${HEARTHDAOC_CONTAINER:-hearthdaoc-server}"
VOLUME="${HEARTHDAOC_VOLUME:-hearthdaoc-data}"
UIDGID="${HEARTHDAOC_UID:-1000}:${HEARTHDAOC_GID:-1000}"
PORT="${HEARTHDAOC_PORT:-10301}"
DB=/data/world/opendaoc.sqlite3.db
ADMIN=(python3 /app/bin/world_admin.py --data /data --lock /app/upstream.lock)

compose() { docker compose -p "$PROJECT" -f "$here/compose.yml" --env-file "$here/.env" "$@"; }
# Create the volume with compose's labels when hdc needs it before the first "up", so compose adopts it.
ensure_volume() { docker volume inspect "$VOLUME" >/dev/null 2>&1 || docker volume create \
    --label com.docker.compose.project="$PROJECT" --label com.docker.compose.volume=data "$VOLUME" >/dev/null; }
image() { echo "${HEARTHDAOC_IMAGE:-ghcr.io/lometur/hearthdaoc}:${HEARTHDAOC_TAG:?set HEARTHDAOC_TAG in .env}"; }
running() { [[ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" == true ]]; }
# Prints why the server is not starting (crash loop or a stopped container after a refusal), else returns 1.
refusal() {
    local state restarting count running code health why
    state="$(docker inspect -f '{{.State.Restarting}} {{.RestartCount}} {{.State.Running}} {{.State.ExitCode}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$CONTAINER" 2>/dev/null)" || return 1
    read -r restarting count running code health <<<"$state"
    [[ "$health" == healthy ]] && return 1
    if [[ "$running" == false && "$restarting" == false ]]; then
        # Stopped: only the entrypoint's refusal codes count (not hdc stop, even after an earlier crash).
        [[ " 2 3 4 64 65 70 " == *" $code "* ]] || return 1
    elif [[ "$restarting" != true && "$count" -eq 0 ]]; then
        return 1  # starting normally (boot, first download)
    fi
    why="$(docker logs --tail 300 "$CONTAINER" 2>&1 | grep '^ERROR' | tail -1 || true)"
    echo "Server: not starting (automatic restarts: $count) - ${why:-exit code $code, see ./hdc logs}"
    echo "Fix the cause, then ./hdc up again. ./hdc stop ends the retries."
}
need_stopped() { if running; then echo "The server is running. Stop it first: ./hdc stop" >&2; exit 1; fi; }
# Throwaway container on the world volume with no network: the upstream import engine and the
# bot-goals tool look for game servers on local ports, and host ports (OpenDAoC) must not count.
offline() { ensure_volume; docker run --rm -i --network none --user "$UIDGID" --cap-drop ALL \
              --security-opt no-new-privileges:true -v "$VOLUME":/data "$@"; }
# tool PROGRAM ARGS...: run inside the live server, or in a throwaway container when stopped.
tool() { if running; then docker exec -i "$CONTAINER" "$@"; else offline --entrypoint "$1" "$(image)" "${@:2}"; fi; }

usage() {
    cat <<'EOF'
hdc - HearthDAoC server

  up | stop | down | logs        start, stop (saves first), remove containers (volume kept), follow logs
  status                         server state, world, accounts, players, bots, latest backup
  init [--seed-navmesh DIR]      create the world now (optionally reuse verified navmesh files from DIR)
  add-bots <alb|mid|hib> <1|10|100> <1|50>
  account create <name> <password> [--plvl 1-3] | list | plvl <name> <1-3>
  bot-goals show | set <1-19|20-49|50> <solo> <group> <rvr> [<battlegrounds>] | reset | import <file>
                                 (changes need the server stopped; set keeps Battlegrounds % when it is left out)
  backup | backups               take a manual backup now (kept until you delete it) | list backups
  restore <backup file name> [--force]   (server stopped; --force allows another edition)
  new-world [--edition classic|b]   archive the current world and start a fresh one (server stopped)
  upgrade-world [--same-version]    move progress into the clean world of this image's upstream version (server stopped)
  carry-rvr [<archive>]          bring back the state of the keeps and relics in play in an archived world (server
                                 stopped; undoes later captures of them); without <archive>, list the archived worlds
  auto-accounts on|off           allow or stop account creation at first login (recreates the server)
  spawns restore [--max-level N] | undo | status
                                 bring back the leveling monsters upstream archived (default levels 1-20; server stopped)
  update [TAG] | update --check  back up, install a release (latest by default) and restart; --check only reports
                                 (a release for another upstream version upgrades the world first)
EOF
}

RELEASES="${HEARTHDAOC_RELEASES_URL:-https://github.com/lometur/HearthDAoC/releases}"
latest_release() {  # GitHub redirects .../releases/latest to .../releases/tag/<tag>
    curl -fsSI "$RELEASES/latest" | tr -d '\r' | sed -n 's|^[Ll]ocation: .*/tag/\([^/]*\)$|\1|p' | tail -1
}
lock_version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$1" | head -1; }
# The upstream version of the world in the volume; empty when there is no world yet.
world_version() { { offline --entrypoint cat "$(image)" /data/world.json 2>/dev/null || true; } \
    | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1; }

# update [TAG] [--bundle FILE] [--check]: back up, install a release's deploy bundle, keep .env values
# (adding new settings with their defaults), pull and restart. When the release is for another upstream
# version, it first upgrades the world as ./hdc upgrade-world does; if that fails, the world stays as it
# was and the server is not started. --bundle uses a local bundle (tests).
update() {
    local tag="" bundle="" check="" arg previous="${HEARTHDAOC_TAG:-}"
    for arg in "$@"; do
        case "$arg" in
            --check) check=1 ;;
            --bundle) bundle=next ;;
            *) if [[ "$bundle" == next ]]; then bundle="$arg"; else tag="$arg"; fi ;;
        esac
    done
    if [[ -n "$check" ]]; then
        tag="$(latest_release)"; [[ -n "$tag" ]] || { echo "Could not reach $RELEASES." >&2; exit 1; }
        echo "Running ${HEARTHDAOC_TAG}; latest release: $tag."
        if [[ "$tag" != "$HEARTHDAOC_TAG" ]]; then echo "Update with: ./hdc update $tag"; fi
        return 0
    fi
    local work; work="$(mktemp -d "$here/.update.XXXXXX")"
    trap "rm -rf '$work'" EXIT  # expanded now: $work is local and gone when the script exits
    if [[ -n "$bundle" ]]; then
        cp "$bundle" "$work/bundle.tgz"
    else
        tag="${tag:-$(latest_release)}"; [[ -n "$tag" ]] || { echo "Could not find the latest release at $RELEASES." >&2; exit 1; }
        if [[ "$tag" == "$HEARTHDAOC_TAG" ]]; then echo "Already on $tag."; return 0; fi
        echo "Downloading $tag..."
        curl -fsSL -o "$work/bundle.tgz" "$RELEASES/download/$tag/hearthdaoc-deploy-$tag.tar.gz" \
            || { echo "No deploy bundle for $tag at $RELEASES." >&2; exit 1; }
    fi
    mkdir "$work/new" && tar xzf "$work/bundle.tgz" -C "$work/new"
    local f
    for f in compose.yml .env.example hdc HANDOFF.md upstream.lock; do
        [[ -f "$work/new/$f" ]] || { echo "The bundle has no $f; nothing changed." >&2; exit 1; }
    done
    tag="$(sed -n 's/^HEARTHDAOC_TAG=//p' "$work/new/.env.example" | tr -d '"')"

    echo "Backing up the world first..."
    tool python3 /app/bin/backup.py --data /data create --label pre-update
    compose stop >/dev/null 2>&1 || true

    cp "$work/new/compose.yml" "$work/new/HANDOFF.md" "$work/new/upstream.lock" "$work/new/.env.example" "$here/"
    local line key added=""
    while IFS= read -r line; do
        [[ "$line" =~ ^([A-Z0-9_]+)= ]] || continue
        key="${BASH_REMATCH[1]}"
        if ! grep -q "^$key=" "$here/.env"; then
            [[ -n "$added" ]] || printf '\n# Added by hdc update %s (defaults from .env.example)\n' "$tag" >> "$here/.env"
            echo "$line" >> "$here/.env"; added+=" $key"
        fi
    done < "$work/new/.env.example"
    sed -i "s/^HEARTHDAOC_TAG=.*/HEARTHDAOC_TAG=$tag/" "$here/.env"
    chmod +x "$work/new/hdc" && mv -f "$work/new/hdc" "$here/hdc"  # mv: this running script keeps its old copy
    [[ -z "$added" ]] || echo "New settings added to .env with their defaults:$added"
    source "$here/.env"

    compose pull --ignore-pull-failures >/dev/null 2>&1 || true
    docker image inspect "$(image)" >/dev/null 2>&1 || { echo "Could not get the image $(image)." >&2; exit 1; }
    local world new_version report=""
    new_version="$(lock_version "$here/upstream.lock")"
    world="$(world_version)"
    if [[ -n "$world" && "$world" != "$new_version" ]]; then
        echo "Installed $tag, which is for upstream $new_version; the world is from upstream $world."
        echo "Upgrading the world to upstream $new_version (the same steps as ./hdc upgrade-world)..."
        # The hdc just installed runs it, so the upgrade steps are the new release's own.
        if ! "$here/hdc" upgrade-world 2>&1 | tee "$work/upgrade.log"; then
            if [[ "$(world_version)" == "$new_version" ]]; then
                echo "The world was upgraded, but a step after it failed (see above). Start the server with: ./hdc up" >&2
            else
                echo "The world upgrade failed (see above). The world is as it was, and the server was not started." >&2
                echo "Fix the cause and try again: ./hdc upgrade-world   then: ./hdc up" >&2
                echo "Or go back to the release you had: ./hdc update ${previous:-<previous tag>}" >&2
            fi
            exit 1
        fi
        report="$(sed -n 's/^Upgrade report: //p' "$work/upgrade.log" | tail -1)"
    fi
    "$here/hdc" up
    echo "Updated to $tag."
    if [[ -n "$report" ]]; then
        echo "Upgrade report (server settings to re-check): docker exec $CONTAINER cat $report"
        echo "This first start on upstream $new_version downloads the changed navmeshes; ./hdc logs shows the progress."
    fi
}

cmd="${1:-help}"; shift || true
case "$cmd" in
    up|start)
        compose up -d
        for _ in $(seq 1 10); do
            sleep 2
            if refusal >&2; then exit 1; fi
            [[ "$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$CONTAINER")" == healthy ]] && break
        done
        echo "Started. ./hdc status shows progress (the first start downloads the world)." ;;
    stop) compose stop ;;
    down) compose down ;;
    logs) compose logs -f --tail=200 server ;;
    status)
        if refusal; then
            offline --entrypoint python3 "$(image)" "${ADMIN[@]:1}" status || true
            exit 0
        elif running; then
            echo "Server: running ($(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}no health check{{end}}' "$CONTAINER"))"
        else
            echo "Server: stopped"
        fi
        tool "${ADMIN[@]}" status ;;
    init)
        need_stopped
        args=(); mounts=()
        if [[ "${1:-}" == --seed-navmesh ]]; then
            mounts=(-v "$(realpath "${2:?folder}")":/seed:ro); args=(--seed-navmesh /seed)
        fi
        ensure_volume
        docker run --rm --network host --user "$UIDGID" -v "$VOLUME":/data "${mounts[@]}" --entrypoint python3 "$(image)" \
            /app/bin/init_world.py --lock /app/upstream.lock --data /data --edition "${HEARTHDAOC_EDITION:-classic}" "${args[@]}" ;;
    add-bots)
        running || { echo "Start the server first (./hdc up); new bots log in while it runs." >&2; exit 1; }
        docker exec -i "$CONTAINER" /app/bin/add-bots.sh "$@" ;;
    account)
        if [[ "${1:-}" == plvl ]] && ! running; then
            tool python3 /app/tools/accounts/accounts.py --db "$DB" "$@" --server-stopped
        else
            tool python3 /app/tools/accounts/accounts.py --db "$DB" "$@"
        fi ;;
    bot-goals)
        sub="${1:-show}"
        if [[ "$sub" == show ]]; then
            tool dotnet /app/tools/bot-goals/bot-goals.dll --port "$PORT" /data show
        else
            need_stopped
            if [[ "$sub" == import ]]; then
                f="$(realpath "${2:?file}")"
                offline -v "$f":/import/bot-goals.json:ro --entrypoint dotnet "$(image)" \
                    /app/tools/bot-goals/bot-goals.dll --port "$PORT" /data import /import/bot-goals.json
            else
                offline --entrypoint dotnet "$(image)" /app/tools/bot-goals/bot-goals.dll --port "$PORT" /data "$@"
            fi
        fi ;;
    backup) tool python3 /app/bin/backup.py --data /data create --label manual ;;  # kept until you delete it
    backups) tool python3 /app/bin/backup.py --data /data list ;;
    restore) need_stopped; offline --entrypoint python3 "$(image)" "${ADMIN[@]:1}" restore "${1:?backup file name (see ./hdc backups)}" "${@:2}" ;;
    new-world)
        need_stopped
        edition="${HEARTHDAOC_EDITION:-classic}"
        [[ "${1:-}" == --edition ]] && edition="${2:?classic or b}"
        ensure_volume
        docker run --rm --network host --user "$UIDGID" -v "$VOLUME":/data --entrypoint python3 "$(image)" \
            "${ADMIN[@]:1}" new-world --edition "$edition"
        if [[ "$edition" != "${HEARTHDAOC_EDITION:-classic}" ]]; then
            sed -i "s/^HEARTHDAOC_EDITION=.*/HEARTHDAOC_EDITION=$edition/" "$here/.env"
            echo "Updated HEARTHDAOC_EDITION=$edition in .env."
        fi ;;
    upgrade-world)
        need_stopped
        # Download with the network, then import in a container without one: upstream's import engine
        # refuses while anything listens on port 10300, and the host's OpenDAoC server must not count.
        ensure_volume
        docker run --rm --network host --user "$UIDGID" -v "$VOLUME":/data --entrypoint python3 "$(image)" \
            "${ADMIN[@]:1}" fetch-clean
        offline --entrypoint python3 "$(image)" "${ADMIN[@]:1}" upgrade-world --clean-world /data/upgrade-clean-world.db \
            --importer "dotnet /app/tools/progress-import/progress-import.dll" "$@" ;;
    carry-rvr)
        if [[ $# -eq 0 ]]; then
            tool "${ADMIN[@]}" carry-rvr
        else
            need_stopped
            offline --entrypoint python3 "$(image)" "${ADMIN[@]:1}" carry-rvr "$@"
        fi ;;
    auto-accounts)
        case "${1:-}" in on) v=True ;; off) v=False ;; *) echo "usage: hdc auto-accounts on|off" >&2; exit 2 ;; esac
        if grep -q '^HEARTHDAOC_AUTO_ACCOUNTS=' "$here/.env"; then
            sed -i "s/^HEARTHDAOC_AUTO_ACCOUNTS=.*/HEARTHDAOC_AUTO_ACCOUNTS=$v/" "$here/.env"
        else
            echo "HEARTHDAOC_AUTO_ACCOUNTS=$v" >> "$here/.env"
        fi
        compose up -d --force-recreate
        echo "Account creation at first login is now $1." ;;
    spawns)
        if [[ "${1:-status}" == status ]]; then
            tool python3 /app/bin/spawns.py --data /data status
        else
            need_stopped
            offline --entrypoint python3 "$(image)" /app/bin/spawns.py --data /data "$@"
        fi ;;
    update) update "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
